# Le séparateur "__" représente un niveau dans le fichier YAML.
IVOIREVOICE_CONFIG_PATH=configs/project.yaml
IVOIREVOICE_PROJECT__DEFAULT_LANGUAGE=fr
IVOIREVOICE_PROJECT__DEFAULT_MODEL=dummy
IVOIREVOICE_API__MAX_UPLOAD_SIZE_MB=25
IVOIREVOICE_LOG_LEVEL=INFO

# Données et artefacts hors du dépôt. Remplacer ces exemples localement.
IVOIREVOICE_DIOULA_DATA_DIR=/path/outside/repository/voices_data
IVOIREVOICE_ARTIFACTS_DIR=/path/outside/repository/artifacts
IVOIREVOICE_HASH_AUDIO=true
