# Le séparateur "__" représente un niveau dans le fichier YAML.
IVOIREVOICE_CONFIG_PATH=configs/project.yaml
IVOIREVOICE_PROJECT__DEFAULT_LANGUAGE=fr
IVOIREVOICE_PROJECT__DEFAULT_MODEL=dummy
IVOIREVOICE_API__MAX_UPLOAD_SIZE_MB=25
# L'intégration web ne conserve jamais l'audio utilisateur.
IVOIREVOICE_API__AUDIO_RETENTION=delete_immediately
IVOIREVOICE_LOG_LEVEL=INFO

# Données et artefacts hors du dépôt. Remplacer ces exemples localement.
IVOIREVOICE_DIOULA_DATA_DIR=/path/outside/repository/voices_data
IVOIREVOICE_ARTIFACTS_DIR=/path/outside/repository/artifacts
IVOIREVOICE_DIOULA_INTERIM_DIR=/path/outside/repository/interim/converted_dioula
IVOIREVOICE_MODEL_CACHE_DIR=/path/outside/repository/cache/models
IVOIREVOICE_CHECKPOINT_DIR=/path/outside/repository/checkpoints
# Requis seulement pour reproduire les expériences d'entraînement historiques.
IVOIREVOICE_DIOULA_PILOT_MODEL_PATH=/path/to/checkpoint-000140
# Modèle final gelé utilisé par l'interface locale.
IVOIREVOICE_DIOULA_FINAL_MODEL_PATH=/path/to/checkpoint-002052
# Facultatif : audio externe ou nouvel enregistrement préparé pour la démo.
IVOIREVOICE_DEMO_AUDIO_PATH=/path/outside/corpus/demo_audio.wav
# Requis avec DEMO_AUDIO_PATH ; confirme que le fichier n'appartient à aucun split.
IVOIREVOICE_DEMO_AUDIO_CONFIRMATION=SAFE_EXTERNAL_DEMO_AUDIO
IVOIREVOICE_HASH_AUDIO=true

# L'unique final_holdout a été consommé. Ne définir aucune confirmation de relance.

# Interface locale uniquement. Ne pas activer le partage public Gradio.
IVOIREVOICE_UI_HOST=127.0.0.1
IVOIREVOICE_UI_PORT=7860

# Origine FastAPI privée lue uniquement par le serveur Next.js.
# Ne jamais renommer cette variable avec le préfixe NEXT_PUBLIC_.
IVOIREVOICE_API_INTERNAL_URL=http://127.0.0.1:8000

# Smoke réel optionnel : uniquement voix synthétique ou audio externe autorisé,
# jamais le corpus, les artefacts ou le final holdout. Le chemin DYU est facultatif.
IVOIREVOICE_WEB_ASR_SMOKE_BASE_URL=http://127.0.0.1:8000
IVOIREVOICE_WEB_ASR_SMOKE_FR_AUDIO_PATH=/path/outside/repository/safe_french_audio.wav
IVOIREVOICE_WEB_ASR_SMOKE_EN_AUDIO_PATH=/path/outside/repository/safe_english_audio.wav
IVOIREVOICE_WEB_ASR_SMOKE_DYU_AUDIO_PATH=
IVOIREVOICE_WEB_ASR_SMOKE_CONFIRMATION=SAFE_EXTERNAL_OR_SYNTHETIC_AUDIO_NOT_FROM_PROJECT_DATA
